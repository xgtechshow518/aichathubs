# =============================================================================
# Docker Compose — published host ports (OPTIONAL)
#
# Copy to `.env` only if the default ports below are already taken on your
# machine. Compose reads this file automatically for ${VAR} substitution in
# docker-compose.yml. These control ONLY which host ports are published — the
# app's own secrets live in backend/.env (see backend/.env.example).
#
#     cp .env.example .env      # then edit the ports you need
# =============================================================================

# PostgreSQL  ->  http://localhost:<DB_PORT>
DB_PORT=5432

# Backend API ->  http://localhost:<BACKEND_PORT>
BACKEND_PORT=8080

# Frontend    ->  http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=5173

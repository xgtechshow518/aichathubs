# =============================================================================
# AIChatsHub — frontend configuration
#
# Copy this file to `.env` and adjust for your deployment:
#     cp .env.example .env
#
# All VITE_* vars are baked into the browser bundle at build time, so they are
# PUBLIC — never put secrets here. (A Google OAuth *client ID* is public; the
# client *secret* belongs only in the backend .env.)
# =============================================================================

# ---- Backend API location ---------------------------------------------------
# Point these at your backend. For local dev with the bundled docker-compose
# the backend is published on http://localhost:8082.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# ---- Google OAuth [OPTIONAL] ------------------------------------------------
# Same client ID as GOOGLE_CLIENT_ID in the backend .env.
# Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=

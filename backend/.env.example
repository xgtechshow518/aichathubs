# =============================================================================
# AIChatsHub — backend configuration
#
# Copy this file to `.env` and fill in YOUR OWN values:
#     cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.
# Legend:  [REQUIRED] must be set   ·   [OPTIONAL] leave blank to disable
# =============================================================================

# ---- Server ----------------------------------------------------------------
# Port the API listens on.
SERVER_PORT=8080
# Bind address. Use 0.0.0.0 in Docker/servers, 127.0.0.1 for local-only dev.
LISTEN_HOST=0.0.0.0

# ---- Database [REQUIRED] ----------------------------------------------------
# PostgreSQL connection string. With the bundled docker-compose the host is
# the service name `db`; for a local Postgres use `localhost`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_live_chats?sslmode=disable

# ---- Auth / JWT [REQUIRED] --------------------------------------------------
# Secret used to sign login tokens. MUST be a long random string.
# Generate one with:   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_EXPIRY_DAYS=7

# ---- Admin panel [REQUIRED] -------------------------------------------------
# Credentials for the admin dashboard at /admin/login. CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password

# ---- Gemini AI [REQUIRED for AI auto-reply] ---------------------------------
# Get a key at https://aistudio.google.com/apikey
# Leave blank to run without AI (WhatsApp auto-reply will be disabled).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MATCH_SCORE_THRESHOLD=0.3
# Default system persona for the AI. Override to change bot behavior.
GEMINI_SYSTEM_PROMPT=You are a professional and friendly customer service assistant. Answer customer questions accurately based on the provided knowledge base. Be concise, helpful, and polite. Reply in the same language the customer uses. If you cannot find the answer in the knowledge base, politely say so and suggest contacting a human agent. Never make up information.

# ---- SMTP / email [OPTIONAL] ------------------------------------------------
# Used to send email-verification codes on registration.
# Leave SMTP_HOST blank to skip email verification (users are auto-verified).
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=

# ---- Google OAuth login [OPTIONAL] ------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Leave blank to hide the "Sign in with Google" button (email login still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# ---- Facebook OAuth login [OPTIONAL] ----------------------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:8080/api/auth/facebook/callback

# ---- Billing / Stripe [OPTIONAL] --------------------------------------------
# Only needed if you charge users per connected WhatsApp device.
# Set BILLING_ENABLED=false to run fully free (no Stripe, no device limit).
# Get keys at https://dashboard.stripe.com/apikeys
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ---- Frontend / CORS --------------------------------------------------------
# URL where the frontend is served (used for CORS + OAuth redirects).
FRONTEND_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated. Optional.
CORS_ORIGINS=

# ---- WhatsApp ---------------------------------------------------------------
# SQLite file for WhatsApp session storage. In Docker this lives on a volume.
WHATSAPP_DB_PATH=file:whatsapp_sessions.db?_foreign_keys=on
